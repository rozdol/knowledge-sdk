{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-graph.local/schemas/knowledge-activity/activity.schema.json",
  "title": "Knowledge Activity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "type", "summary", "created_at", "source", "events",
    "affected_objects", "undo_available", "restore_available", "privacy"
  ],
  "properties": {
    "id": {"type":"string","pattern":"^activity_[0-9A-HJKMNP-TV-Z]{26}$"},
    "type": {"enum":["knowledge_added","knowledge_changed","knowledge_archived","knowledge_restored"]},
    "summary": {"type":"string","minLength":1},
    "created_at": {"type":"string","format":"date-time"},
    "source": {"type":"string","minLength":1},
    "actor": {"type":"string","minLength":1},
    "proposal": {"type":"string","pattern":"^proposal_[0-9A-HJKMNP-TV-Z]{26}$"},
    "events": {
      "type":"array","uniqueItems":true,
      "items":{"type":"string","pattern":"^event_[0-9A-HJKMNP-TV-Z]{26}$"}
    },
    "affected_objects": {
      "type":"array",
      "items": {
        "type":"object","additionalProperties":false,"required":["id","kind"],
        "properties": {
          "id":{"type":"string"},"kind":{"type":"string"},
          "name":{"type":"string"},"state":{"type":"string"}
        }
      }
    },
    "undo_available": {"type":"boolean"},
    "restore_available": {"type":"boolean"},
    "privacy": {"enum":["visible","redacted"]}
  }
}
