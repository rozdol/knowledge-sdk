{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge.local/schemas/structured-dataset-definition.json",
  "title": "Structured Dataset Definition",
  "type": "object",
  "required": ["slug", "name", "kind", "purpose", "sensitivity", "columns"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
    "purpose": { "type": "string", "minLength": 1 },
    "sensitivity": { "type": "string", "enum": ["normal", "private", "restricted"] },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
          "type": { "type": "string", "enum": ["TEXT", "INTEGER", "REAL", "BOOLEAN", "DATE", "DATETIME", "JSON"] },
          "required": { "type": "boolean" },
          "unique": { "type": "boolean" },
          "index": { "type": "boolean" },
          "unit": { "type": "string", "minLength": 1 },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "enum": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "pattern": { "type": "string" },
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
