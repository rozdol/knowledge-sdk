{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dashboard v1 terminal widget envelope",
  "$comment": "Common envelope only. Each implemented route also applies its typed Gateway contract and presentation field allow-list.",
  "type": "object",
  "required": [
    "contract_version",
    "request_id",
    "status",
    "data",
    "warnings",
    "scope",
    "window",
    "computed_at",
    "sources",
    "completeness",
    "evidence",
    "error"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^request_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "empty",
        "partial",
        "unavailable",
        "stale",
        "error"
      ]
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "owner_id",
        "subject_id",
        "account_id"
      ],
      "properties": {
        "owner_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "account_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "required": [
        "from",
        "to",
        "bounds",
        "as_of",
        "timezone"
      ],
      "properties": {
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        },
        "bounds": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "inclusive_dates",
            "inclusive_instants",
            "half_open_instants"
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "version",
          "observed_at"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "completeness": {
      "type": "object",
      "required": [
        "complete",
        "limitations"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [],
        "properties": {
          "record_id": {
            "type": "string"
          },
          "evidence_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
