[
  {
    "manifest_schema_version": "1.0.0",
    "capability_id": "kg.datasets.query",
    "name": "query_structured_datasets",
    "version": "1.0.0",
    "description": "Execute a supported deterministic natural-language query over policy-visible structured datasets.",
    "input_schema": {
      "type": "object",
      "required": ["query"],
      "properties": { "query": { "type": "string", "minLength": 1, "maxLength": 1000 } },
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "required": ["query", "kind", "answers", "dataset", "explanation"],
      "properties": {
        "query": { "type": "string" }, "kind": { "type": "string" },
        "answers": { "type": "array", "items": { "type": "object" } },
        "dataset": { "type": "object" }, "explanation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "errors": ["InvalidArguments", "PolicyDenied", "ExecutionFailed", "Timeout"],
    "execution": { "mode": "synchronous", "effects": "read_only", "timeout_ms": 15000, "idempotent": true },
    "policy": { "permissions": ["dataset:read"], "risk": "low", "approval": "none" },
    "explanation": { "required": true },
    "transports": ["hermes", "mcp", "cli", "rest"],
    "examples": [{ "arguments": { "query": "What was my latest hemoglobin?" } }],
    "deprecation": { "status": "active" }
  },
  {
    "manifest_schema_version": "1.0.0",
    "capability_id": "kg.datasets.describe",
    "name": "describe_structured_dataset",
    "version": "1.0.0",
    "description": "Describe a canonical Dataset registry entry and its versioned row schema.",
    "input_schema": {
      "type": "object", "required": ["dataset"],
      "properties": { "dataset": { "type": "string", "minLength": 1, "maxLength": 200 } },
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object", "required": ["dataset"],
      "properties": { "dataset": { "type": "object" } }, "additionalProperties": false
    },
    "errors": ["InvalidArguments", "PolicyDenied", "ExecutionFailed", "Timeout"],
    "execution": { "mode": "synchronous", "effects": "read_only", "timeout_ms": 5000, "idempotent": true },
    "policy": { "permissions": ["dataset:read"], "risk": "low", "approval": "none" },
    "explanation": { "required": true },
    "transports": ["hermes", "mcp", "cli", "rest"],
    "examples": [{ "arguments": { "dataset": "blood_tests" } }],
    "deprecation": { "status": "active" }
  }
]
