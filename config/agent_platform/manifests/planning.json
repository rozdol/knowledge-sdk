            "priority": { "type": "string", "enum": ["low", "normal", "high", "critical"] },
            "deadline": { "type": "string", "format": "date" },
            "constraints": { "type": "object", "maxProperties": 20 },
            "preferences": { "type": "object", "maxProperties": 50 },
            "success_criteria": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 1000 } },
            "status": { "type": "string", "enum": ["active", "archived", "completed"] }
