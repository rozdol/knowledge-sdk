        "decision_id": { "type": "string" }, "goal": { "type": "object" },
        "snapshot_digest": { "type": "string" }, "as_of": { "type": "string", "format": "date" },
        "policy_version": { "type": "string" }, "approved_plan": { "type": ["object", "null"] },
        "ranked_plans": { "type": "array", "items": { "type": "object" } },
        "decision_trace": { "type": "object" }, "executable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errors": ["InvalidArguments", "PolicyDenied", "ExecutionFailed", "Timeout"],
    "execution": { "mode": "synchronous", "effects": "read_only", "timeout_ms": 120000, "idempotent": true },
    "policy": { "permissions": ["planning:read"], "risk": "low", "approval": "none" },
    "explanation": { "required": true },
    "transports": ["hermes", "mcp", "cli", "rest"],
    "examples": [{ "arguments": { "goal": { "description": "Reach a synthetic target", "goal_type": "generic" }, "as_of": "2026-07-30" } }],
