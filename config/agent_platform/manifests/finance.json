[
  {
    "manifest_schema_version": "1.0.0",
    "capability_id": "kg.finance.read",
    "name": "finance_read",
    "version": "1.0.0",
    "description": "Read derived exact financial reports.",
    "input_schema": {
      "type": "object",
      "required": [
        "content"
      ],
      "properties": {
        "source_type": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "language": {
          "type": "string"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "external_id": {
          "type": "string"
        },
        "source_uri": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "observation_id": {
          "type": "string"
        },
        "origin_source": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "sender": {
          "type": "string"
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "normal",
            "private",
            "restricted"
          ]
        },
        "finance_pending": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "required": [
        "status",
        "execution_authorized"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "execution_authorized": {
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": true
    },
    "errors": [
      "InvalidArguments",
      "PolicyDenied",
      "ExecutionFailed",
      "Timeout"
    ],
    "execution": {
      "mode": "synchronous",
      "effects": "read_only",
      "timeout_ms": 30000,
      "idempotent": true
    },
    "policy": {
      "permissions": [
        "finance:read",
        "dataset:read",
        "graph:read"
      ],
      "risk": "low",
      "approval": "none"
    },
    "explanation": {
      "required": true
    },
    "transports": [
      "hermes",
      "mcp",
      "cli",
      "rest"
    ],
    "examples": [
      {
        "arguments": {
          "content": "Сколько у меня акций Microsoft?"
        }
      }
    ],
    "deprecation": {
      "status": "active"
    }
  },
