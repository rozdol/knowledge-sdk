  {
    "manifest_schema_version": "1.0.0",
    "capability_id": "kg.graph.relationship_path",
    "name": "find_relationship_path",
    "version": "1.0.0",
    "description": "Find a deterministic shortest path between immutable entity IDs.",
    "input_schema": {
      "type": "object", "required": ["source_id", "target_id"],
      "properties": {
        "source_id": { "type": "string", "minLength": 3, "maxLength": 200 },
        "target_id": { "type": "string", "minLength": 3, "maxLength": 200 },
        "mode": { "type": "string", "enum": ["auto", "social", "knowledge"] },
        "as_of": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object", "required": ["source_id", "target_id", "mode", "graph_path", "distance"],
      "properties": {
        "source_id": { "type": "string" }, "target_id": { "type": "string" },
        "mode": { "type": "string" }, "graph_path": { "type": ["array", "null"], "items": { "type": "string" } },
        "distance": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "errors": ["CapabilityNotFound", "InvalidArguments", "PolicyDenied", "ExecutionFailed", "Timeout"],
    "execution": { "mode": "synchronous", "effects": "read_only", "timeout_ms": 15000, "idempotent": true },
    "policy": { "permissions": ["graph:read"], "risk": "low", "approval": "none" },
    "explanation": { "required": true },
    "transports": ["hermes", "mcp", "cli", "rest"],
    "examples": [{ "arguments": { "source_id": "person_A", "target_id": "person_B", "mode": "social" } }],
    "deprecation": { "status": "active" }
  },
