[
  {
    "manifest_schema_version": "1.0.0",
    "capability_id": "kg.entities.search",
    "name": "search_entities",
    "version": "1.0.0",
    "description": "Search canonical entity identities without exposing storage paths or implementation details.",
    "input_schema": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": { "type": "string", "minLength": 1, "maxLength": 500 },
        "entity_type": { "type": "string", "minLength": 1, "maxLength": 80 },
        "strong_only": { "type": "boolean" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "required": ["query", "matches"],
      "properties": { "query": { "type": "string" }, "matches": { "type": "array", "items": { "type": "object" } } },
      "additionalProperties": false
    },
    "errors": ["InvalidArguments", "PolicyDenied", "ExecutionFailed", "Timeout"],
    "execution": { "mode": "synchronous", "effects": "read_only", "timeout_ms": 5000, "idempotent": true },
    "policy": { "permissions": ["graph:read"], "risk": "low", "approval": "none" },
    "explanation": { "required": true },
    "transports": ["hermes", "mcp", "cli", "rest"],
    "examples": [{ "arguments": { "query": "Ada", "entity_type": "person" } }],
    "deprecation": { "status": "active" }
  },
