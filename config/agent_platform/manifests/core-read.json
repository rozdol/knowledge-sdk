      "type": "object",
      "properties": {
        "analyzers": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "enum": ["relationship", "knowledge_gap", "opportunity", "followup", "activity", "project", "timeline", "network", "memory", "anomaly", "consistency", "recommendation"] }
        },
        "as_of": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object", "required": ["snapshot_digest", "as_of", "results", "feature_metrics"],
      "properties": {
        "snapshot_digest": { "type": "string" }, "as_of": { "type": "string", "format": "date" },
        "results": { "type": "array", "items": { "type": "object" } }, "feature_metrics": { "type": "object" }
      },
      "additionalProperties": false
    },
    "errors": ["InvalidArguments", "PolicyDenied", "ExecutionFailed", "Timeout"],
    "execution": { "mode": "synchronous", "effects": "read_only", "timeout_ms": 60000, "idempotent": true },
    "policy": { "permissions": ["intelligence:read"], "risk": "low", "approval": "none" },
    "explanation": { "required": true },
    "transports": ["hermes", "mcp", "cli", "rest"],
    "examples": [{ "arguments": { "analyzers": ["relationship", "followup"], "as_of": "2026-07-30" } }],
    "deprecation": { "status": "active" }
  },
